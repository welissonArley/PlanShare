<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlanShare.App.Views.Pages.WorkItem.Detail.WorkItemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:animationComponent="clr-namespace:PlanShare.App.Views.Components.StatusPage"
    xmlns:fontFamily="clr-namespace:PlanShare.App.Constants"
    xmlns:models="clr-namespace:PlanShare.App.Models"
    xmlns:resourceFile="clr-namespace:PlanShare.App.Resources"
    xmlns:skeleton="clr-namespace:PlanShare.App.Views.Components.Skeletons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModel="clr-namespace:PlanShare.App.ViewModels.Pages.WorkItem.Detail"
    x:Name="PageWorkItemDetail"
    x:DataType="viewModel:WorkItemDetailViewModel"
    Style="{StaticResource PageWithScrollView}">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource PAGE_BACKGROUND_COLOR_LIGHT}, Dark={StaticResource PAGE_BACKGROUND_COLOR_DARK}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
        <toolkit:EventToCommandBehavior Command="{Binding Path=BindingContext.InitializeCommand, Source={Reference PageWorkItemDetail}}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="0,0,30,0">

            <!--  Default  -->
            <VerticalStackLayout IsVisible="False" Spacing="20">
                <VerticalStackLayout.Triggers>
                    <DataTrigger
                        Binding="{Binding StatusPage}"
                        TargetType="VerticalStackLayout"
                        Value="{Static models:StatusPage.Default}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Label
                    FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_BLACK}"
                    FontSize="18"
                    Text="{Binding Model.Title}" />

                <VerticalStackLayout Spacing="4">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_LIGHT}"
                        FontSize="16"
                        Text="{Static resourceFile:ResourceTexts.TITLE_DATE}" />
                    <Label FontSize="18" Text="{Binding Model.DueDate, StringFormat='{}{0:dddd, dd MMMM yyyy}'}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_LIGHT}"
                        FontSize="16"
                        Text="{Static resourceFile:ResourceTexts.DESCRIPTION}" />
                    <Label FontSize="16" Text="{Binding Model.Description}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_BLACK}"
                        FontSize="14"
                        Text="{Static resourceFile:ResourceTexts.TITLE_ASSIGNEES}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.Assignees}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ConnectedUser">
                                <Grid
                                    Padding="0,12,0,0"
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,1"
                                    RowSpacing="12">
                                    <Label
                                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_REGULAR}"
                                        FontSize="18"
                                        Text="{Binding Name}"
                                        VerticalOptions="Center" />
                                    <Image
                                        Grid.Column="1"
                                        HeightRequest="14"
                                        Source="icon_close.png"
                                        VerticalOptions="Center"
                                        WidthRequest="14">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource PRIMARY_COLOR_LIGHT}, Dark={StaticResource PRIMARY_COLOR_DARK}}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <BoxView
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        HeightRequest="1"
                                        Color="{AppThemeBinding Light={StaticResource LINES_COLOR_LIGHT},
                                                                Dark={StaticResource LINES_COLOR_DARK}}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Grid
                    Margin="0,20,0,0"
                    ColumnDefinitions="*,50"
                    ColumnSpacing="15">
                    <Button
                        Command="{Binding EditWorkItemCommand}"
                        FontSize="18"
                        Text="{Static resourceFile:ResourceTexts.EDIT_TASK}" />
                    <ImageButton
                        Grid.Column="1"
                        Padding="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource DANGER_ACTION_COLOR_LIGHT},
                                                          Dark={StaticResource DANGER_ACTION_COLOR_DARK}}"
                        Command="{Binding DeleteCommand}"
                        CornerRadius="15"
                        HeightRequest="50"
                        Source="icon_trash.png"
                        WidthRequest="50">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource SECONDARY_COLOR_LIGHT}, Dark={StaticResource SECONDARY_COLOR_DARK}}" />
                        </ImageButton.Behaviors>
                    </ImageButton>
                </Grid>
            </VerticalStackLayout>

            <!--  Loading  -->
            <VerticalStackLayout IsVisible="False" Spacing="20">
                <VerticalStackLayout.Triggers>
                    <DataTrigger
                        Binding="{Binding StatusPage}"
                        TargetType="VerticalStackLayout"
                        Value="{Static models:StatusPage.Loading}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <skeleton:SkeletonView
                    CornerRadius="4"
                    HeightRequest="24"
                    HorizontalOptions="Start"
                    WidthRequest="260" />

                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_LIGHT}"
                        FontSize="16"
                        Text="{Static resourceFile:ResourceTexts.TITLE_DATE}" />
                    <skeleton:SkeletonView
                        CornerRadius="4"
                        HeightRequest="20"
                        HorizontalOptions="Start"
                        WidthRequest="220" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_LIGHT}"
                        FontSize="16"
                        Text="{Static resourceFile:ResourceTexts.DESCRIPTION}" />
                    <skeleton:SkeletonView CornerRadius="4" HeightRequest="16" />
                    <skeleton:SkeletonView CornerRadius="4" HeightRequest="16" />
                    <skeleton:SkeletonView
                        CornerRadius="4"
                        HeightRequest="16"
                        HorizontalOptions="Start"
                        WidthRequest="200" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label
                        FontFamily="{Static fontFamily:FontFamily.MAIN_FONT_BLACK}"
                        FontSize="14"
                        Text="{Static resourceFile:ResourceTexts.TITLE_ASSIGNEES}" />
                    <skeleton:SkeletonView
                        Margin="0,12,0,0"
                        CornerRadius="4"
                        HeightRequest="20" />
                    <skeleton:SkeletonView
                        Margin="0,12,0,0"
                        CornerRadius="4"
                        HeightRequest="20" />
                    <skeleton:SkeletonView
                        Margin="0,12,0,0"
                        CornerRadius="4"
                        HeightRequest="20" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <animationComponent:AnimationSendingInformationComponent IsVisible="False">
                <animationComponent:AnimationSendingInformationComponent.Triggers>
                    <DataTrigger
                        Binding="{Binding StatusPage}"
                        TargetType="animationComponent:AnimationSendingInformationComponent"
                        Value="{Static models:StatusPage.Sending}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </animationComponent:AnimationSendingInformationComponent.Triggers>
            </animationComponent:AnimationSendingInformationComponent>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
